      <material name="wowrobo_rear_screw_1">
        <color rgba="0.35 0.36 0.38 1" />
      </material>
    </visual>
    <collision name="wowrobo_rear_screw_1">
      <origin xyz="0.017 0.0761226588 -0.0541617314" rpy="-2.61799388 0 3.14159265" />
      <geometry>
        <cylinder radius="0.0027" length="0.0034" />
      </geometry>
    </collision>
    <visual name="wowrobo_rear_screw_2">
      <origin xyz="-0.017 0.0466777951 -0.0371617314" rpy="-2.61799388 0 3.14159265" />
      <geometry>
        <cylinder radius="0.0017" length="0.0014" />
      </geometry>
      <material name="wowrobo_rear_screw_2">
        <color rgba="0.35 0.36 0.38 1" />
      </material>
    </visual>
    <collision name="wowrobo_rear_screw_2">
      <origin xyz="-0.017 0.0466777951 -0.0371617314" rpy="-2.61799388 0 3.14159265" />
      <geometry>
        <cylinder radius="0.0027" length="0.0034" />
      </geometry>
    </collision>
    <visual name="wowrobo_rear_screw_3">
      <origin xyz="-0.017 0.0761226588 -0.0541617314" rpy="-2.61799388 0 3.14159265" />
      <geometry>
        <cylinder radius="0.0017" length="0.0014" />
      </geometry>
      <material name="wowrobo_rear_screw_3">
        <color rgba="0.35 0.36 0.38 1" />
      </material>
    </visual>
    <collision name="wowrobo_rear_screw_3">
      <origin xyz="-0.017 0.0761226588 -0.0541617314" rpy="-2.61799388 0 3.14159265" />
      <geometry>
        <cylinder radius="0.0027" length="0.0034" />
      </geometry>
    </collision>
  </link>

  <!-- Gripper frame (dummy link + fixed joint) -->
  <link name="gripper_frame_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="1e-9" />
      <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0" />
    </inertial>
  </link>

  <!-- Estimated camera body frame: +X forward, +Y left, +Z up.
     Origin is at the geometric lens-front center, not a calibrated optical center. -->
  <link name="camera_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="1e-9" />
      <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0" />
    </inertial>
  </link>

  <joint name="camera_joint" type="fixed">
    <origin xyz="0 0.0497502269 -0.0558401233" rpy="3.14159265 1.04719755 -1.57079633" />
    <parent link="gripper_link" />
    <child link="camera_link" />
    <axis xyz="0 0 0" />
  </joint>

  <joint name="gripper_frame_joint" type="fixed">
    <!-- Nominal midpoint of the distal 1 mm of both undeformed fingers at gripper=0. -->
    <origin xyz="-0.00165747 0.00076389 -0.10587056" rpy="0 3.14159 0" />
    <parent link="gripper_link" />
    <child link="gripper_frame_link" />
    <axis xyz="0 0 0" />
  </joint>

  <link name="fixed_finger_link">
    <visual><geometry><mesh filename="meshes/soft_fixed_finger.stl" /></geometry><material name="soft_orange" /></visual>
    <collision><geometry><mesh filename="meshes/soft_fixed_finger_collision_part_0.stl" /></geometry></collision>
    <collision><geometry><mesh filename="meshes/soft_fixed_finger_collision_part_1.stl" /></geometry></collision>
    <collision><geometry><mesh filename="meshes/soft_fixed_finger_collision_part_2.stl" /></geometry></collision>
    <collision><geometry><mesh filename="meshes/soft_fixed_finger_collision_part_3.stl" /></geometry></collision>
    <collision><geometry><mesh filename="meshes/soft_fixed_finger_collision_part_4.stl" /></geometry></collision>
    <collision><geometry><mesh filename="meshes/soft_fixed_finger_collision_part_5.stl" /></geometry></collision>
    <collision><geometry><mesh filename="meshes/soft_fixed_finger_collision_part_6.stl" /></geometry></collision>
    <collision><geometry><mesh filename="meshes/soft_fixed_finger_collision_part_7.stl" /></geometry></collision>
    <collision><geometry><mesh filename="meshes/soft_fixed_finger_collision_part_8.stl" /></geometry></collision>
    <collision><geometry><mesh filename="meshes/soft_fixed_finger_collision_part_9.stl" /></geometry></collision>
    <collision><geometry><mesh filename="meshes/soft_fixed_finger_collision_part_10.stl" /></geometry></collision>
    <collision><geometry><mesh filename="meshes/soft_fixed_finger_collision_part_11.stl" /></geometry></collision>
    <collision><geometry><mesh filename="meshes/soft_fixed_finger_collision_part_12.stl" /></geometry></collision>
    <collision><geometry><mesh filename="meshes/soft_fixed_finger_collision_part_13.stl" /></geometry></collision>
    <collision><geometry><mesh filename="meshes/soft_fixed_finger_collision_part_14.stl" /></geometry></collision>
    <collision><geometry><mesh filename="meshes/soft_fixed_finger_collision_part_15.stl" /></geometry></collision>
  </link>
  <joint name="fixed_finger_joint" type="fixed">
    <parent link="gripper_link" />
    <child link="fixed_finger_link" />
  </joint>

  <!-- Link moving_jaw_so101_v1 (kept as our existing simple single-revolute jaw) -->
  <link name="moving_jaw_so101_v1_link">
    <inertial>
      <origin xyz="-0.00157495 -0.0300244 0.0192755" rpy="0 0 0" />
      <mass value="0.012" />
      <inertia ixx="6.61427e-06" ixy="-3.19807e-07" ixz="-5.90717e-09" iyy="1.89032e-06"
        iyz="-1.09945e-07" izz="5.28738e-06" />
    </inertial>
    <!-- Part moving_jaw_so101_v1 -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/soft_moving_holder.stl" />
      </geometry>
      <material name="printed_white" />
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/soft_moving_holder.stl" />
      </geometry>

    </collision>
  </link>

  <link name="moving_finger_link">
    <visual><geometry><mesh filename="meshes/soft_moving_finger.stl" /></geometry><material name="soft_orange" /></visual>
    <collision><geometry><mesh filename="meshes/soft_moving_finger_collision_part_0.stl" /></geometry></collision>
    <collision><geometry><mesh filename="meshes/soft_moving_finger_collision_part_1.stl" /></geometry></collision>
    <collision><geometry><mesh filename="meshes/soft_moving_finger_collision_part_2.stl" /></geometry></collision>
    <collision><geometry><mesh filename="meshes/soft_moving_finger_collision_part_3.stl" /></geometry></collision>
    <collision><geometry><mesh filename="meshes/soft_moving_finger_collision_part_4.stl" /></geometry></collision>
    <collision><geometry><mesh filename="meshes/soft_moving_finger_collision_part_5.stl" /></geometry></collision>
    <collision><geometry><mesh filename="meshes/soft_moving_finger_collision_part_6.stl" /></geometry></collision>
    <collision><geometry><mesh filename="meshes/soft_moving_finger_collision_part_7.stl" /></geometry></collision>
    <collision><geometry><mesh filename="meshes/soft_moving_finger_collision_part_8.stl" /></geometry></collision>
    <collision><geometry><mesh filename="meshes/soft_moving_finger_collision_part_9.stl" /></geometry></collision>
    <collision><geometry><mesh filename="meshes/soft_moving_finger_collision_part_10.stl" /></geometry></collision>
    <collision><geometry><mesh filename="meshes/soft_moving_finger_collision_part_11.stl" /></geometry></collision>
    <collision><geometry><mesh filename="meshes/soft_moving_finger_collision_part_12.stl" /></geometry></collision>
    <collision><geometry><mesh filename="meshes/soft_moving_finger_collision_part_13.stl" /></geometry></collision>
    <collision><geometry><mesh filename="meshes/soft_moving_finger_collision_part_14.stl" /></geometry></collision>
    <collision><geometry><mesh filename="meshes/soft_moving_finger_collision_part_15.stl" /></geometry></collision>
  </link>
  <joint name="moving_finger_joint" type="fixed">
    <parent link="moving_jaw_so101_v1_link" />
    <child link="moving_finger_link" />
  </joint>

  <joint name="shoulder_pan" type="revolute">
    <origin xyz="0.0449 -0.000250002 0.0663" rpy="3.14159 1.0534e-08 3.12052" />
    <parent link="base_link" />
    <child link="shoulder_link" />
    <axis xyz="0 0 1" />
    <limit effort="10" velocity="10" lower="-1.91986" upper="1.91986" />
  </joint>

  <joint name="shoulder_lift" type="revolute">
    <origin xyz="-0.0306 -0.0198 -0.0522" rpy="-1.5708 -1.5708 0" />
    <parent link="shoulder_link" />
    <child link="upper_arm_link" />
    <axis xyz="0 0 1" />
    <limit effort="10" velocity="10" lower="-1.74533" upper="1.74533" />
  </joint>

  <joint name="elbow_flex" type="revolute">
    <!-- axis flipped relative to the raw CAD export: this joint's origin carries an extra ~180 deg
       roll about X compared to so101.urdf's elbow_flex (same physical motor, unchanged calibration),
       which inverts the sign of a "0 0 1" axis as seen from the parent frame. Without this flip the
       joint rotates opposite to the real robot. -->
    <origin xyz="-0.112485 -0.028 0.04" rpy="-3.14159 -0 1.5708" />
    <parent link="upper_arm_link" />
    <child link="lower_arm_link" />
    <axis xyz="0 0 -1" />
    <limit effort="10" velocity="10" lower="-1.69" upper="1.69" />
  </joint>

  <!-- forearm_roll: the printed part's own added joint (called "elbow_roll" in the onshape export). -->
  <joint name="forearm_roll" type="revolute">
    <origin xyz="-0.0626 0 0.0201" rpy="-1.5708 3.14159 -1.5708" />
    <parent link="lower_arm_link" />
    <child link="forearm_roll_link" />
    <axis xyz="0 0 1" />
    <limit effort="10" velocity="10" lower="-3.14159" upper="3.14159" />
  </joint>

  <joint name="wrist_flex" type="revolute">
    <origin xyz="-0.00498613 0.0198678 -0.0728416" rpy="1.5708 0 -0" />
    <parent link="forearm_roll_link" />
    <child link="wrist_link" />
    <axis xyz="0 0 1" />
    <limit effort="10" velocity="10" lower="-3.14159" upper="3.14159" />
  </joint>

  <!-- Origin taken from so101.urdf's own wrist_roll (rather than the onshape export's), so it
  matches
     the gripper_link content restored below. -->
  <joint name="wrist_roll" type="revolute">
    <origin xyz="5.55112e-17 -0.0611 0.0181" rpy="1.5708 1.5708 3.14159" />
    <parent link="wrist_link" />
    <child link="gripper_link" />
    <axis xyz="0 0 1" />
    <limit effort="10" velocity="10" lower="-2.74385" upper="2.84121" />
  </joint>

  <!-- Joint from gripper to moving_jaw_so101_v1 (kept as our existing simple jaw joint) -->
  <joint name="gripper" type="revolute">
    <origin xyz="0.0202 0.0188 -0.0234" rpy="1.5708 -5.24284e-08 -1.41553e-15" />
    <parent link="gripper_link" />
    <child link="moving_jaw_so101_v1_link" />
    <axis xyz="0 0 1" />
    <limit effort="10" velocity="10" lower="-0.174533" upper="1.74533" />
  </joint>

  <!-- Optical axes: +Z forward, +X image-right, +Y image-down. -->
  <link name="camera_optical_frame" />
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link" />
    <child link="camera_optical_frame" />
    <origin xyz="0 0 0" rpy="-1.57079632679 0 -1.57079632679" />
  </joint>
</robot>
